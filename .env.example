# ─────────────────────────────────────────────────────────────
# Example environment file.
#
# This is a TEMPLATE. It is safe to commit to Git because it
# contains no real secrets.
#
# To use it: copy this file to ".env" and fill in your real values.
# ─────────────────────────────────────────────────────────────

# Your Telegram bot token, obtained from @BotFather.
# Format: 123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Optional: restrict the bot to one Telegram user ID.
# Leave empty to allow anyone who finds the bot to use it.
# To find your Telegram user ID, message @userinfobot on Telegram.
TELEGRAM_ALLOWED_USER_ID=

# Market symbol. 1HZ100V = Volatility 100 (1s) Index on Deriv.
MARKET_SYMBOL=1HZ100V

# Candle granularity in seconds. 60 = 1-minute candles.
CANDLE_GRANULARITY=60

# Forecast horizon in minutes. The bot predicts the direction over
# this many minutes into the future.
FORECAST_HORIZON_MINUTES=15

# Minimum absolute price change (as a percentage) required to
# classify a forecast as a directional win. Movements smaller than
# this are treated as NEUTRAL for evaluation purposes.
MIN_MOVE_PCT=0.01

# Logging level: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO